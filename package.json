{
  "name": "helmy-job-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Job tracker bersama HelsTJ dengan Next.js, React, Cloudflare Workers, dan D1",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "start": "wrangler dev",
    "next:dev": "next dev",
    "build": "next build",
    "test": "node --test",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:db:migrate": "wrangler d1 migrations apply helmy-job-tracker --remote",
    "cf:db:import": "node scripts/import-jobs-to-d1.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
